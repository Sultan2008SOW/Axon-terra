# Copier ce fichier en ".env" et adapter les valeurs.
# NE JAMAIS committer le fichier ".env" réel (secrets).

# Clé secrète Flask (sessions, CSRF) — générer une valeur aléatoire longue en production.
SECRET_KEY=change-moi-en-production

# Identifiants de connexion à l'administration (/admin/login)
ADMIN_USERNAME=contact@axonterra.org
# Hash du mot de passe admin, généré avec :
#   python -c "from werkzeug.security import generate_password_hash as g; print(g('votre_mot_de_passe'))"
# Si absent, mot de passe par défaut de développement : admin123
ADMIN_PASSWORD_HASH=

# Notification email à l'administrateur lors d'un nouveau message de contact (optionnel)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-compte@gmail.com
SMTP_PASSWORD=mot-de-passe-application
ADMIN_NOTIFY_EMAIL=contact@axonterra.org
